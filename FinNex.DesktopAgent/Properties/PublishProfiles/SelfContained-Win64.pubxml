<?xml version="1.0" encoding="utf-8"?>
<!--
  FinNex Desktop Agent — Self-Contained Publish Profili
  =====================================================
  Bu profil ilə publish edilən .exe:
    ✓ .NET runtime daxildir — işçidə heç nə yüklənmir
    ✓ Tək fayl (.exe) — qovluqda yalnız exe + appsettings.json
    ✓ win-x64 hədəf — 64-bit Windows (Windows 7 SP1+)

  Visual Studio-da: Build → Publish → SelfContained-Win64 seç → Publish
  Əmr sətirindən:
      dotnet publish -p:PublishProfile=SelfContained-Win64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>

    <!-- .NET runtime exe-nin içinə paketlənir — xarici .NET tələb etmir -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Bütün fayllar tək .exe-yə birləşdirilir -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Faylın ölçüsünü azaltmaq üçün sıxışdırma -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- İstifadə edilməyən .NET kodlarını çıxarır — daha kiçik fayl -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Debug simvolları ayrı faylda saxlama -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
