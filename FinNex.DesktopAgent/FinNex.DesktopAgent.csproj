<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Assembly metadata — antivirus və SmartScreen üçün proqramı tanıdır -->
    <AssemblyTitle>FinNex Desktop Agent</AssemblyTitle>
    <AssemblyDescription>FinNex işçi bildiriş agenti — real vaxtlı masa üstü bildirişlər</AssemblyDescription>
    <Company>FinNex</Company>
    <Product>FinNex Desktop Agent</Product>
    <Copyright>Copyright © FinNex 2025</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <NeutralLanguage>az-Latn-AZ</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
    <!-- Windows DPAPI (ProtectedData) — token-i şifrəli saxlamaq üçün -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
